{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "plugins": [
            {
                "name": "next"
            }
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./*"
            ],
            "@java-village/database": [
                "../../packages/database/src/index.ts"
            ],
            "@java-village/game-logic": [
                "../../packages/game-logic/src/index.ts"
            ],
            "@java-village/assets": [
                "../../packages/assets/src/index.ts"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}